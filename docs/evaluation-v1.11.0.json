  "harness_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport sys\nimport time\nfrom unittest.mock import patch\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0,str(ROOT))\nfrom scripts import evaluate_local as evaluation\noriginal = evaluation.preference_profile\ndef custom(hardware, power):\n    return original(hardware, 'Custom', cpu=min(12,hardware['threads']), context=8192)\nbase = ROOT/'evaluation-results'/('custom-'+time.strftime('%Y%m%d-%H%M%S'))\nbase.mkdir()\nmodel = evaluation.LocalModel('qwen2.5-coder:7b')\ndigest = next((m.get('digest') for m in model.installed_models() if m.get('name')==model.model),None)\ncode = hashlib.sha256(b''.join(p.name.encode()+p.read_bytes() for p in sorted((ROOT/'local_agent').glob('*.py')))).hexdigest()\nprint('OUTPUT',base,flush=True)\nwith patch.object(evaluation,'preference_profile',custom):\n    status = evaluation.evaluate_multifile(base,model,model.model,digest,code,suite='tags')\nreport = {'version':'1.11.0-preview','date':'2026-10-03','scope':'Guided trusted tag trials with Custom power: up to 12 threads and 8192 context. Not less-guided acceptance or a hard resource cap.',\n          'harness_source':Path(__file__).read_text(encoding='utf-8'),\n          'harness_digest':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n          'results':json.loads((base/'results.json').read_text(encoding='utf-8'))}\n(ROOT/'docs/evaluation-v1.11.0.json').write_text(json.dumps(report,indent=2)+'\\n',encoding='utf-8')\nraise SystemExit(status)\n",
